# Meridian — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# =============================================================================
# Database (Neon Postgres — free tier)
# Get from: https://console.neon.tech
# =============================================================================
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/meridian?sslmode=require
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@ep-xxx.us-east-2.aws.neon.tech/meridian?sslmode=require

# =============================================================================
# LLM Provider API Keys (all free tiers)
# =============================================================================

# Groq — https://console.groq.com
GROQ_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cloudflare Workers AI — https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# NVIDIA NIM (optional — requires account)
NVIDIA_API_KEY=

# =============================================================================
# LLM-as-a-Judge Configuration
# Stored in every BenchmarkRun for reproducibility (SRS FR-3.5)
# =============================================================================
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-1.5-flash-latest
JUDGE_MODEL_VERSION=gemini-1.5-flash-001   # Pinned version for reproducibility

# =============================================================================
# Security
# =============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# JWT secret for session tokens (if auth is added)
SECRET_KEY=change-me-in-production

# =============================================================================
# App Configuration
# =============================================================================
APP_ENV=development        # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Railway Deployment (set automatically by Railway in production)
# =============================================================================
PORT=8000
